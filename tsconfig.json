{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // Node-side files (vite/playwright configs, tests-offline/) need @types/node, which is not installed;
  // Vite and Playwright transpile them without type-checking.
  "include": ["src", "tests"]
}
